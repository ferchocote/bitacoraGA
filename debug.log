  LEFT JOIN bc_estado_proceso ep ON ep.Id = p.IdEstadoProceso
  LEFT JOIN bc_cliente c
      ON c.ID = p.IdImportador
  
  ORDER BY DiasRestantes ASC
  LIMIT 10 OFFSET 0
